# Copiar a .env y completar. NUNCA commitear el .env real.
PORT=5000

# URL DIRECTA (sin pooler). Usar solo para prisma migrate / scripts locales.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"

# URL con POOLER. Es la que usa el runtime (Render, Vercel, produccion).
# Pooler transaccional: requiere ?pgbouncer=true o Prisma se cuelga.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

JWT_SECRET=<generar-un-secreto-largo>

# Supabase S3 (fotos y documentos medicos)
S3_ENDPOINT="https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3"
S3_REGION=sa-east-1
S3_ACCESS_KEY_ID=<key>
S3_SECRET_ACCESS_KEY=<secret>
S3_BUCKET=k9-photo